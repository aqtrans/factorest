# Same as the password-file
pwfile = "/etc/factorest/passwd"
# Same as the repository flag
repo = "rest:http://user:password@127.0.0.1:8050/"
debug = true
listen_port = "8080"

[[jobs]]
name = "backup_home"
tag = ["home"]
files = ["/home/user/Documents", "/home/user/Projects/go"]
preHook = ["echo 'Starting backup of home directory'", "touch /tmp/home_backup_started"]
postHook = ["echo 'Home directory backup completed'", "touch /tmp/home_backup_completed"]
assigned_to = [ "desktop", "laptop" ]

[[jobs]]
name = "backup_work"
tag = ["work"]
files = ["/home/user/Work"]
preHook = ["echo omgomgomg"]
postHook = ["echo omg"]
assigned_to = [ "laptop" ]

[[clients]]
name = "laptop"
schedule_time = "4:40 pm"

[[clients]]
name = "desktop"
schedule_time = "12:00 am"